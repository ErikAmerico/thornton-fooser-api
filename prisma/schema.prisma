generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Player {
  id    String @id @default(cuid())
  name  String @unique
  loginCode String? @unique
  score Float  @default(0)
  championships Int @default(0)  
  chatMessages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  //Player defines which model we are refferring to
  //fields: userId is saying grab the userId column in this model
  //references: id is saying to compare userId to the id of somone in the Player table
  //becase we are saying user is type of Player
  user      Player   @relation(fields: [userId], references: [id])
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Tournament {
  id         Int             @id @default(autoincrement())
  createdAt  DateTime        @default(now())
  teams      Json
  results    Json            
}